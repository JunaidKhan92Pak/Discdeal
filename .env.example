# Copy this file to .env.local (same folder) and fill in your own values.
# .env.local is private: it is ignored by git, so it is never uploaded. Never paste these values into chat.

# Your Supabase database connection (Supabase → your project → Connect → "Transaction pooler" → URI).
# Replace [YOUR-PASSWORD] in it with your database password.
# Leave it empty to keep using the spreadsheet data/deals.csv instead of a database.
DATABASE_URL=

# Optional: your website's public address, once you have your own domain (e.g. https://discdeal.pk).
# Used in the sitemap, link previews and search-engine data. Empty = the address Vercel gives the project.
NEXT_PUBLIC_SITE_URL=

# Optional: lets `npm run db:import` work on networks that block database connections (CONNECT_TIMEOUT).
# The import then goes over HTTPS through Supabase's API. Make one at supabase.com → your avatar → Account
# preferences → Access Tokens → Generate new token. It can manage your whole Supabase account: keep it secret,
# only here in .env.local, and revoke it on that page if it ever leaks.
SUPABASE_ACCESS_TOKEN=

# Optional: Redis (Upstash, free tier). Shares cached answers and rate limits across all servers, and lets
# `npm run db:import` clear the cache so new deals show at once. Leave empty to cache inside each server only.
# Upstash → your database → REST API. (On Vercel's Upstash integration the names KV_REST_API_URL /
# KV_REST_API_TOKEN also work.)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional tuning. Leave empty for the default in brackets.
# Seconds the loaded deals are kept before reading the database again [60]
CATALOG_CACHE_SECONDS=
# Seconds one search's answer is kept on the server [60]
SEARCH_CACHE_SECONDS=
# Seconds Vercel's CDN may serve a search answer without asking the server [60]
CDN_CACHE_SECONDS=
# Searches one visitor may make per minute before getting "slow down" [120]
RATE_LIMIT_PER_MINUTE=
# Log in / register tries one visitor may make per minute (slows down password guessing) [10]
AUTH_ATTEMPTS_PER_MINUTE=
# Days a login lasts before asking to log in again [30]
SESSION_DAYS=
